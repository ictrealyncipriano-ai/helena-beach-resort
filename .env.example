APP_NAME="Resort Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# REPLACE on every new resort deployment: APP_NAME, APP_URL, SESSION_DOMAIN,
# MAIL_FROM_ADDRESS, MAIL_FROM_NAME and BOOKING_REF_PREFIX (use the resort's
# own name, domain, sender and initials). Database, storage (R2) and payment
# (PayMongo) credentials below must also be set per deployment.
APP_URL=https://resort.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supabase PostgreSQL (production)
DB_CONNECTION=pgsql
DB_HOST=db.[your-project].supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-password
DB_SSLMODE=require

# Local SQLite (development)
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.resort.example.com

# Must be true in production (behind HTTPS) so the session cookie is only sent over TLS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=cloudflare

# Mails are queued (all mailables implement ShouldQueue). Keep `sync` until a
# queue worker runs (`php artisan queue:work`); `database` without a worker
# piles jobs in the jobs table and nothing is ever sent.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Resend (production email)
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@resort.example.com
MAIL_FROM_NAME="Resort Management System"
RESEND_API_KEY=your-resend-api-key

# Mailhog / Log (development)
# MAIL_MAILER=log

# Cloudflare R2 (image storage)
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-key
CLOUDFLARE_R2_DEFAULT_REGION=auto
CLOUDFLARE_R2_BUCKET=your-bucket-name
CLOUDFLARE_R2_URL=https://pub-xxx.r2.dev
CLOUDFLARE_R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com

# AWS (fallback S3 storage, not used with R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Vercel Cron: bearer token sent on each cron invocation.
# Set the same value in the Vercel project dashboard (Settings -> Environment Variables).
# Use a strong random value, e.g. `php -r "echo bin2hex(random_bytes(32));"`
# The literal placeholder "change-me" is rejected by the app — never ship it.
CRON_SECRET=

# PayMongo (online payments: QR Ph)
# Get keys at https://dashboard.paymongo.com -> Developers -> API Keys
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Trusted proxies: comma-separated IPs/CIDRs that may set X-Forwarded-* headers
# (e.g. Vercel/Cloudflare edge IPs). Leave empty to trust no proxies.
# Example: TRUSTED_PROXIES=10.0.0.0/8,192.168.1.0/24
TRUSTED_PROXIES=

# Booking reference prefix (guest-facing codes, e.g. RS-XXXXXXXXXX).
# Set per resort deployment using the resort's initials, e.g. SP- for Sunset Paradise Resort.
# Existing codes keep working — this only affects newly generated references.
BOOKING_REF_PREFIX=RS-
